---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import GuideCard from '../../components/GuideCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CopyEmailButton from '../../components/CopyEmailButton.astro';
import { useTranslations } from '../../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);

// Fetch, filter by lang === 'en', and sort dynamically by date descending
const allGuides = await getCollection('guides');
const featuredGuides = allGuides
  .filter(guide => (guide.data.lang || 'tr') === 'en')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => (project.data.lang || 'tr') === 'en');
---

<Layout 
  lang={lang}
  title="Veysi Can Keten | AI & Cloud Systems Architect"
  description="AI tools, cloud infrastructure architectures, and open-source system blueprints."
>
  <div class="max-w-6xl mx-auto px-6 md:px-8">
    
    <!-- Hero Section -->
    <Hero lang={lang} />

    <!-- Guides Section -->
    <Section 
      id="guides" 
      title={t('section.guidesTitle')}
      subtitle={t('section.guidesSubtitle')}
    >
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredGuides.map(guide => (
          <GuideCard 
            title={guide.data.title}
            description={guide.data.description}
            category={guide.data.category}
            slug={guide.id.replace('-en', '')} 
            readTime={guide.data.readTime}
            lang={lang}
          />
        ))}
      </div>
    </Section>

    <!-- Projects Section -->
    <Section 
      id="projects" 
      title={t('section.projectsTitle')}
      subtitle={t('section.projectsSubtitle')}
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredProjects.map(project => (
          <ProjectCard 
            title={project.data.title}
            description={project.data.description}
            techs={project.data.techs}
            githubUrl={project.data.githubUrl}
            demoUrl={project.data.demoUrl}
            status={project.data.status}
            lang={lang}
          />
        ))}
      </div>
    </Section>

    <!-- About Section -->
    <Section 
      id="about" 
      title={t('section.aboutTitle')}
      subtitle={t('section.aboutSubtitle')}
    >
      <div class="glass-card p-8 md:p-10 rounded-3xl space-y-8 relative overflow-hidden">
        
        <!-- Ambient glow inside card -->
        <div class="absolute -bottom-10 -right-10 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-3">
            <span class="px-3 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono font-bold text-emerald-400">
              Computer Science B.Sc.
            </span>
            <span class="px-3 py-1 rounded-md bg-sky-500/10 border border-sky-500/20 text-xs font-mono font-bold text-sky-400">
              AWS Certified Cloud Practitioner Candidate
            </span>
          </div>

          <h3 class="text-2xl font-bold text-slate-100">
            {t('about.role')}
          </h3>
          <p class="text-slate-300 text-base md:text-lg leading-relaxed max-w-4xl font-normal">
            {t('about.bio')}
          </p>
        </div>

        <!-- Skills Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-slate-800/80">
          
          <!-- Card 1: AI & ML -->
          <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold">
              🧠
            </div>
            <h4 class="font-bold text-slate-100 text-lg">{t('about.card1Title')}</h4>
            <p class="text-slate-400 text-sm leading-relaxed">
              {t('about.card1Desc')}
            </p>
          </div>

          <!-- Card 2: Cloud & DevOps -->
          <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-center justify-center text-sky-400 font-bold">
              ☁️
            </div>
            <h4 class="font-bold text-slate-100 text-lg">{t('about.card1Title')}</h4>
            <p class="text-slate-400 text-sm leading-relaxed">
              {t('about.card2Desc')}
            </p>
          </div>

          <!-- Card 3: Hybrid Endurance -->
          <div class="p-5 rounded-2xl bg-slate-950/60 border border-slate-800 space-y-3">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 font-bold">
              ⚡
            </div>
            <h4 class="font-bold text-slate-100 text-lg">{t('about.card3Title')}</h4>
            <p class="text-slate-400 text-sm leading-relaxed">
              {t('about.card3Desc')}
            </p>
          </div>

        </div>

        <!-- Direct Social & Action Links -->
        <div class="flex flex-wrap items-center justify-between gap-6 pt-6 border-t border-slate-800/80">
          <div class="flex flex-wrap items-center gap-4">
            <a 
              href="https://github.com/vyscnktn" 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-emerald-400 hover:border-emerald-500/40 transition-all font-semibold text-sm flex items-center gap-2"
            >
              <span>{t('about.github')}</span>
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
            </a>

            <a 
              href="https://linkedin.com/in/veysicanketen" 
              target="_blank" 
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-emerald-400 hover:border-emerald-500/40 transition-all font-semibold text-sm flex items-center gap-2"
            >
              <span>{t('about.linkedin')}</span>
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>

            <CopyEmailButton variant="primary" lang={lang} />
          </div>

          <div class="text-xs text-slate-500 font-mono">
            {t('about.location')}
          </div>
        </div>

      </div>
    </Section>

  </div>
</Layout>
