---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

// 1. Klasördeki tüm rehberleri bul ve sayfalarını oluştur
export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map(guide => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

// 2. URL'den gelen ilgili rehberi al ve render et
const { guide } = Astro.props;
const { Content } = await render(guide);
---

<html lang="tr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{guide.data.title} | Veysi Can Keten</title>
    <meta name="description" content={guide.data.description} />
  </head>
  <body class="bg-slate-950 text-slate-50 font-sans antialiased">
    <main class="max-w-3xl mx-auto px-6 py-20">
      
      <!-- Geri Dön Butonu -->
      <a href="/" class="text-emerald-400 hover:text-emerald-300 mb-10 inline-flex items-center gap-2 transition-colors font-medium">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Anasayfaya Dön
      </a>
      
      <!-- Rehber Başlığı -->
      <header class="mb-12 border-b border-slate-800 pb-8">
        <span class="text-orange-400 font-bold tracking-widest uppercase text-sm mb-4 block">{guide.data.category}</span>
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-50 mb-6 leading-tight">{guide.data.title}</h1>
        <p class="text-slate-400 text-lg md:text-xl leading-relaxed">{guide.data.description}</p>
      </header>

      <!-- Markdown İçeriği -->
      <article class="markdown-body">
        <Content />
      </article>

    </main>
  </body>
</html>

<style is:global>
  /* Tailwind v4 için ana stil dosyasını referans gösteriyoruz */
  @reference "../../styles/global.css";

  /* Tailwind Markdown (Prose) Stilleri */
  .markdown-body h2 { @apply text-2xl md:text-3xl font-bold text-slate-100 mt-12 mb-6 border-b border-slate-800 pb-2; }
  .markdown-body h3 { @apply text-xl md:text-2xl font-bold text-slate-100 mt-8 mb-4; }
  .markdown-body p { @apply text-slate-300 text-lg leading-relaxed mb-6; }
  .markdown-body ul { @apply list-disc list-outside text-slate-300 mb-6 space-y-2 ml-5 text-lg; }
  .markdown-body li { @apply pl-1; }
  .markdown-body code { @apply bg-slate-800/80 text-emerald-400 px-1.5 py-0.5 rounded text-sm font-mono border border-slate-700/50; }
  .markdown-body pre { @apply bg-slate-900 p-5 rounded-xl overflow-x-auto mb-8 border border-slate-800 shadow-lg shadow-black/20; }
  .markdown-body pre code { @apply bg-transparent text-slate-300 p-0 text-sm border-0 shadow-none; }
  .markdown-body a { @apply text-emerald-400 hover:text-emerald-300 hover:underline underline-offset-4 transition-colors; }
  .markdown-body blockquote { @apply border-l-4 border-emerald-500 bg-emerald-500/5 py-3 pr-4 pl-5 italic text-slate-300 mb-8 rounded-r-lg; }
  .markdown-body strong { @apply text-slate-100 font-bold; }
</style>
