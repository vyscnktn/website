---
import { Image } from 'astro:assets';
// Görselin adını ve uzantısını kendi dosyana göre güncelle
import profilImage from '../assets/profil.jpg'; 
---
<section class="min-h-[75vh] flex flex-col-reverse md:flex-row items-center justify-between py-20 gap-12">
  <div class="flex-1 space-y-6">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-50 tracking-tight leading-tight">
      Merhaba, ben <span class="text-emerald-400">Veysi Can</span>.
    </h1>
    <p class="text-lg md:text-xl text-slate-300 max-w-2xl leading-relaxed">
      Yapay zeka araçları geliştiriyor, bulut mimarileri kuruyor ve içerikler üretiyorum. Edindiğim teknik tecrübeleri ve oluşturduğum sistemlerin rehberlerini burada paylaşıyorum.
    </p>
    <div class="flex flex-wrap gap-4 pt-4">
      <a href="#guides" class="px-7 py-3.5 bg-emerald-500 text-slate-950 font-bold rounded-xl hover:bg-emerald-400 transition-colors shadow-lg shadow-emerald-500/20">
        Rehberleri Keşfet
      </a>
      <a href="#projects" class="px-7 py-3.5 border-2 border-slate-700 text-slate-200 font-bold rounded-xl hover:bg-slate-800 hover:text-white transition-colors">
        Projeleri Gör
      </a>
    </div>
  </div>
  
  <div class="w-56 h-56 md:w-72 md:h-72 rounded-full bg-gradient-to-tr from-emerald-500 to-orange-500 p-1 flex-shrink-0">
    <div class="w-full h-full bg-slate-950 rounded-full flex items-center justify-center overflow-hidden relative group">
      <!-- Optimizasyonlu Görsel Bileşeni -->
      <Image 
        src={profilImage} 
        alt="Veysi Can Keten" 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 grayscale-[20%] group-hover:grayscale-0"
      />
    </div>
  </div>
</section>