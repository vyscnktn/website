---
import { useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  techs: string[];
  githubUrl: string;
  demoUrl?: string;
  status?: string;
  lang?: 'tr' | 'en';
}
const { title, description, techs, githubUrl, demoUrl, status, lang = 'tr' } = Astro.props;
const t = useTranslations(lang);
---
<div class="glass-card p-6 md:p-8 rounded-2xl transition-all duration-300 group hover:-translate-y-1 flex flex-col justify-between h-full relative overflow-hidden">
  
  <!-- Subtle gradient highlight -->
  <div class="absolute top-0 left-0 w-32 h-32 bg-sky-500/5 rounded-full blur-2xl group-hover:bg-emerald-500/10 transition-all duration-500"></div>

  <div>
    <div class="flex items-center justify-between gap-4 mb-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center text-emerald-400 group-hover:border-emerald-500/30 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
        </div>
        {status && (
          <span class="px-2.5 py-0.5 rounded-full bg-slate-800 border border-slate-700 text-slate-300 text-xs font-mono">
            {status}
          </span>
        )}
      </div>

      <div class="flex items-center gap-2">
        {demoUrl && (
          <a 
            href={demoUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Live Demo"
            class="text-slate-400 hover:text-sky-400 transition-colors p-1"
            title={t('card.liveDemo')}
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          </a>
        )}
        <a 
          href={githubUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="GitHub Repository"
          class="text-slate-400 hover:text-emerald-400 transition-colors p-1"
          title="GitHub Repository"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
        </a>
      </div>
    </div>

    <h3 class="text-xl font-bold text-slate-100 mb-2 group-hover:text-emerald-400 transition-colors leading-snug">
      {title}
    </h3>

    <p class="text-slate-400 text-sm mb-6 leading-relaxed font-normal">
      {description}
    </p>
  </div>

  <div>
    <div class="flex flex-wrap gap-2 mb-6">
      {techs.map(tech => (
        <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-slate-900/90 border border-slate-800 text-emerald-400">
          {tech}
        </span>
      ))}
    </div>

    <div class="flex items-center justify-between pt-3 border-t border-slate-800/60 w-full text-sm font-semibold">
      <a 
        href={githubUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-slate-300 hover:text-emerald-400 inline-flex items-center gap-2 transition-colors"
      >
        <span>{t('card.inspectGithub')}</span>
        <svg class="w-4 h-4 text-slate-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
      </a>

      {demoUrl && (
        <a 
          href={demoUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-sky-400 hover:text-sky-300 inline-flex items-center gap-1.5 transition-colors"
        >
          <span>{t('card.liveDemo')}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      )}
    </div>
  </div>
</div>
