---
interface Props {
  title: string;
  description: string;
  techs: string[];
  githubUrl: string;
}
const { title, description, techs, githubUrl } = Astro.props;
---
<div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl hover:border-emerald-500 transition-all duration-300 group">
  <h3 class="text-xl font-bold text-slate-100 mb-2 group-hover:text-emerald-400 transition-colors">{title}</h3>
  <p class="text-slate-400 mb-5 text-sm leading-relaxed">{description}</p>
  <div class="flex flex-wrap gap-2 mb-6">
    {techs.map(tech => (
      <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-500/10 text-emerald-400 rounded-md">
        {tech}
      </span>
    ))}
  </div>
  <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-slate-300 hover:text-emerald-400 font-medium inline-flex items-center gap-1.5 transition-colors">
    GitHub'da İncele 
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
  </a>
</div>
