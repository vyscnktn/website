---
import { useTranslations } from '../i18n/ui';

interface Props {
  email?: string;
  variant?: 'primary' | 'secondary' | 'glass';
  lang?: 'tr' | 'en';
}
const { email = "veysicanketen@gmail.com", variant = "glass", lang = "tr" } = Astro.props;
const t = useTranslations(lang);

const baseStyles = "relative inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm transition-all duration-300 group cursor-pointer";
const variantStyles = {
  primary: "bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-lg shadow-emerald-500/20",
  secondary: "bg-slate-800 hover:bg-slate-700 text-slate-100 border border-slate-700",
  glass: "glass-card text-slate-200 hover:text-emerald-400 border border-slate-800 hover:border-emerald-500/40"
}[variant];
---

<button 
  id="copy-email-btn"
  data-email={email}
  data-text-default={t('btn.copyEmail')}
  data-text-copied={t('btn.copied')}
  class={`${baseStyles} ${variantStyles}`}
  aria-label={t('btn.copyEmail')}
>
  <svg class="w-4 h-4 text-emerald-400 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
  </svg>
  <span id="copy-text">{t('btn.copyEmail')}</span>
</button>

<!-- Toast notification element -->
<div id="copy-toast" class="fixed bottom-8 right-8 z-50 transform translate-y-10 opacity-0 transition-all duration-300 pointer-events-none">
  <div class="px-5 py-3 rounded-2xl glass-panel border border-emerald-500/40 text-emerald-400 text-sm font-semibold flex items-center gap-2.5 shadow-2xl shadow-emerald-500/20">
    <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
    </svg>
    <span>{t('toast.emailCopied')}</span>
  </div>
</div>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  const copyToast = document.getElementById('copy-toast');

  if (copyBtn && copyToast) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'veysicanketen@gmail.com';
      const textDefault = copyBtn.getAttribute('data-text-default') || 'Copy Email';
      const textCopied = copyBtn.getAttribute('data-text-copied') || 'Copied!';
      try {
        await navigator.clipboard.writeText(email);
        if (copyText) copyText.textContent = textCopied;
        
        // Show Toast
        copyToast.classList.remove('translate-y-10', 'opacity-0');
        copyToast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          if (copyText) copyText.textContent = textDefault;
          copyToast.classList.remove('translate-y-0', 'opacity-100');
          copyToast.classList.add('translate-y-10', 'opacity-0');
        }, 3000);
      } catch (err) {
        console.error('Copy error:', err);
      }
    });
  }
</script>
