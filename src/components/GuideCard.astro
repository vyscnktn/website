---
interface Props {
  title: string;
  description: string;
  category: string;
  slug: string;
}
const { title, description, category, slug } = Astro.props;
---
<a href={`/guides/${slug}`} class="block group h-full">
  <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl hover:border-orange-500 transition-all duration-300 h-full flex flex-col justify-between">
    <div>
      <span class="text-xs font-bold text-orange-400 uppercase tracking-widest mb-3 block">{category}</span>
      <h3 class="text-xl font-bold text-slate-100 mb-3 group-hover:text-orange-400 transition-colors">{title}</h3>
      <p class="text-slate-400 text-sm mb-6 leading-relaxed">{description}</p>
    </div>
    <span class="text-orange-500 text-sm font-semibold inline-flex items-center gap-1">
      Rehberi Oku 
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
    </span>
  </div>
</a>
